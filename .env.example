# Copy to .env. Every integration is optional: if a key is missing, that step
# falls back (logged as "skipped / fallback") and the demo still runs.

# Public URL of this server (ngrok), used for Razorpay callback + TTS media
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Sarvam AI: https://dashboard.sarvam.ai (verify model names in docs)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3

# Twilio WhatsApp sandbox: Console > Messaging > Try it out > WhatsApp
# Set "When a message comes in" to  POST {PUBLIC_BASE_URL}/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Razorpay TEST MODE ONLY (server refuses to start with a live key)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Optional: webhook {PUBLIC_BASE_URL}/razorpay/webhook, event payment_link.paid
RAZORPAY_WEBHOOK_SECRET=

# Flagsmith server-side environment key (ser.xxxx)
FLAGSMITH_ENV_KEY=

# Testnet (e.g. Base Sepolia). Use a throwaway key that only holds faucet funds.
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_PRIVATE_KEY=
CHAIN_EXPLORER_TX=https://sepolia.basescan.org/tx/

# Shared secret between the oracle worker and this server
ORACLE_TOKEN=dev-oracle-token
ORACLE_STALE_SECONDS=90

# Telegram bot (two-way demo channel): token from @BotFather
TELEGRAM_BOT_TOKEN=
